# ansible/inventory/hosts.ini is generated automatically by Terraform.
# This .gitkeep file exists only to ensure the inventory/ directory is tracked by Git.
# The actual hosts.ini file is git-ignored because it contains real server IPs.
#
# To create hosts.ini manually (without Terraform):
#
# [app]
# app1 ansible_host=<app-server-public-ip>
#
# [monitor]
# mon1 ansible_host=<monitor-server-public-ip>
#
# [all:vars]
# ansible_user=ubuntu
# ansible_ssh_private_key_file=~/.ssh/id_rsa
# ansible_ssh_common_args=-o StrictHostKeyChecking=no
